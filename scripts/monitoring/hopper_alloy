#!/bin/sh
#
# PROVIDE: hopper_alloy
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Grafana Alloy shipping hopper's Postgres replication metrics to otel.
# NOTE: do NOT name a knob hopper_alloy_env — FreeBSD rc.subr reserves ${name}_env.

. /etc/rc.subr

name="hopper_alloy"
desc="Grafana Alloy — hopper Postgres replication metrics"
rcvar="hopper_alloy_enable"

load_rc_config $name

: ${hopper_alloy_enable:="NO"}
: ${hopper_alloy_user:="alloy"}
: ${hopper_alloy_config:="/usr/local/etc/hopper-alloy/config.alloy"}
: ${hopper_alloy_secrets:="/usr/local/etc/hopper-alloy/alloy.env"}
: ${hopper_alloy_storage:="/var/db/hopper-alloy"}
: ${hopper_alloy_listen:="127.0.0.1:12347"}
: ${hopper_alloy_wrapper:="/usr/local/etc/hopper-alloy/run.sh"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-r -P ${pidfile} -S -T ${name} -u ${hopper_alloy_user} \
	${hopper_alloy_wrapper}"

start_precmd="hopper_alloy_precmd"
hopper_alloy_precmd()
{
	install -d -o "${hopper_alloy_user}" -g "${hopper_alloy_user}" -m 0750 \
		"${hopper_alloy_storage}"
	# Wrapper sources secrets then execs alloy (avoids DSN shell-escaping issues).
	cat >"${hopper_alloy_wrapper}" <<EOF
#!/bin/sh
set -a
. ${hopper_alloy_secrets}
set +a
exec /usr/local/bin/alloy run ${hopper_alloy_config} \\
  --storage.path=${hopper_alloy_storage} \\
  --server.http.listen-addr=${hopper_alloy_listen}
EOF
	chmod 0755 "${hopper_alloy_wrapper}"
	chown root:alloy "${hopper_alloy_wrapper}"
	chmod 640 "${hopper_alloy_secrets}"
	chown root:alloy "${hopper_alloy_secrets}"
}

run_rc_command "$1"
