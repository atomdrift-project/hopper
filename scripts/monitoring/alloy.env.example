# Copy to /usr/local/etc/hopper-alloy/alloy.env, fill in, chmod 0600, chown alloy:alloy.
# NOT committed — contains the DB password and the Grafana Cloud token.

# Exporter connection to the PUBLISHER (network client; tailnet is encrypted so
# sslmode=disable is acceptable). Role created by exporter-role.sql.
EXPORTER_DSN=postgresql://hopper_exporter:CHANGEME@hopper-db:5432/hopper?sslmode=disable

# Grafana Cloud Prometheus (remote_write). From the Grafana Cloud portal:
#   Connections -> Prometheus -> "Remote Write Endpoint" / "Username" and an
#   access-policy token with the metrics:write scope.
GC_PROM_URL=https://prometheus-prod-XX-REGION.grafana.net/api/prom/push
GC_PROM_USER=000000
GC_PROM_TOKEN=glc_CHANGEME
