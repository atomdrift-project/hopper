# Copy to /usr/local/etc/hopper-alloy/alloy.env, fill in, chmod 0600, chown alloy:alloy.
# NOT committed — contains the DB password and the Grafana Cloud token.

# Exporter connection to the PUBLISHER (network client; tailnet is encrypted so
# sslmode=disable is acceptable). Role + password created by exporter-role.sql.
EXPORTER_DSN=postgresql://hopper_exporter:CHANGEME@hopper-db:5432/hopper?sslmode=disable

# Grafana Cloud OTLP gateway. USER + TOKEN come from ~/.tok/graf, which is a
# single base64 blob of "<user>:<glc_token>" — split it on the first colon:
#   b=$(cat ~/.tok/graf); echo "$b" | base64 -d | cut -d: -f1   # -> GC_OTLP_USER
#   b=$(cat ~/.tok/graf); echo "$b" | base64 -d | cut -d: -f2-  # -> GC_OTLP_TOKEN
# URL is fixed by the stack region (prod-us-east-3).
GC_OTLP_URL=https://otlp-gateway-prod-us-east-3.grafana.net/otlp
GC_OTLP_USER=1669252
GC_OTLP_TOKEN=glc_CHANGEME
