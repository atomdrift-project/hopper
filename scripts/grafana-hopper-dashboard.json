{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping hopper at /_/metrik",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Health of the hopper sample broker: pipeline backlog, throughput, ingestion, insert failures, and the worker fleet. Metrics come from GET /_/metrik (see scripts/prometheus-hopper-alerts.yml).",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["hopper", "atomdrift"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": { "text": "hopper", "value": "hopper" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(hopper_local_worker_up, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Job",
        "name": "job",
        "options": [],
        "query": { "query": "label_values(hopper_local_worker_up, job)", "refId": "job" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(hopper_worker_last_seen_age_seconds{job=\"$job\"}, worker)",
        "hide": 0,
        "includeAll": true,
        "label": "Worker",
        "multi": true,
        "name": "worker",
        "options": [],
        "query": { "query": "label_values(hopper_worker_last_seen_age_seconds{job=\"$job\"}, worker)", "refId": "worker" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Hopper — Health",
  "uid": "hopper-health",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Scrapeable",
      "description": "1 when Prometheus can reach hopper, 0 when the process or dashboard port is down.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "up{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Local scan worker",
      "description": "hopper_local_worker_up — the in-process litmus worker's health.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_local_worker_up{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Pending (first analysis)",
      "description": "Samples awaiting their first analysis.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50000 }, { "color": "red", "value": 250000 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_pending{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Rescan backlog",
      "description": "Samples eligible for re-analysis under the live traits version.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100000 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_rescan{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Analyses/sec (top-level)",
      "description": "Top-level analyses per second over the rate window.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_analysis_rate_per_second{job=\"$job\", tier=\"toplevel\"}" } ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Fleet files/sec",
      "description": "Files analyzed per second across the fleet over the trailing 15 minutes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_files_rate_per_second{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Since last analyzed",
      "description": "Seconds since the most recently analyzed sample. Rising while work is queued means a stall.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 900 }, { "color": "red", "value": 3600 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_workflow_analyzed_age_seconds{job=\"$job\"}" } ]
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Since last added",
      "description": "Seconds since the most recently added sample. Rising means ingestion has stopped feeding the pipeline.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 900 }, { "color": "red", "value": 3600 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_workflow_added_age_seconds{job=\"$job\"}" } ]
    },
    {
      "type": "row",
      "id": 10,
      "title": "Pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Queue backlog by stage",
      "description": "Depth of each pipeline stage. A stage climbing while others drain points to where work is piling up.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "none", "group": "A" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_pending{job=\"$job\"}", "legendFormat": "pending" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_cleave_pending{job=\"$job\"}", "legendFormat": "cleave" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_litmus_pending{job=\"$job\"}", "legendFormat": "litmus" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_queue_rescan{job=\"$job\"}", "legendFormat": "rescan" }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Throughput",
      "description": "Analyses per second by tier, fleet files/sec, and the derived rate of the cumulative analyzed counter.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_analysis_rate_per_second{job=\"$job\", tier=\"toplevel\"}", "legendFormat": "analyses/s toplevel" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_analysis_rate_per_second{job=\"$job\", tier=\"rescan\"}", "legendFormat": "analyses/s rescan" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_files_rate_per_second{job=\"$job\"}", "legendFormat": "fleet files/s" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_analyzed_total{job=\"$job\"}[5m]))", "legendFormat": "analyzed_total rate" }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Freshness & lag",
      "description": "Seconds since the newest added/analyzed sample, and added-to-ready lag. Flat-low is healthy; a rising line means that stage stalled.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 3600 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_workflow_added_age_seconds{job=\"$job\"}", "legendFormat": "added age" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_workflow_analyzed_age_seconds{job=\"$job\"}", "legendFormat": "analyzed age" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_workflow_ready_lag_seconds{job=\"$job\"}", "legendFormat": "ready lag" }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Ingestion / walk",
      "description": "Per-second rates of the process-lifetime walk counters. Counters reset to zero on restart (visible as a drop, which rate() handles).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "errors/s" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_walk_files_total{job=\"$job\"}[5m]))", "legendFormat": "walked/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_walk_inserted_total{job=\"$job\"}[5m]))", "legendFormat": "inserted/s" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_walk_cache_hits_total{job=\"$job\"}[5m]))", "legendFormat": "cache hits/s" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_walk_filtered_total{job=\"$job\"}[5m]))", "legendFormat": "filtered/s" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(hopper_errors_total{job=\"$job\"}[5m]))", "legendFormat": "errors/s" }
      ]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Insert failures",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Insert failures by cause",
      "description": "Failed sample inserts per second, broken out by cause. lock_timeout sustained > 0 is the silent batch-drop mode that took out ingestion on 2026-06-14 — a whole batch fails at once and is dropped, not retried.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal", "group": "A" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "lock_timeout" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (cause) (rate(hopper_insert_failures_total{job=\"$job\"}[5m]))", "legendFormat": "{{cause}}" }
      ]
    },
    {
      "type": "stat",
      "id": 22,
      "title": "Insert failures by cause (1h)",
      "description": "Samples that failed to insert in the last hour, by cause. Anything non-zero under lock_timeout means samples were dropped on lock contention.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "value_and_name", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (cause) (increase(hopper_insert_failures_total{job=\"$job\"}[1h])) > 0", "legendFormat": "{{cause}}", "instant": true }
      ]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Worker fleet",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "id": 31,
      "title": "Workers",
      "description": "Current state of every worker the tracker knows. Last seen rising past ~600s means the node went quiet.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } }, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Last seen" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 600 } ] } } ] },
          { "matcher": { "id": "byName", "options": "RSS" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Files/s" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 1 } ] },
          { "matcher": { "id": "byName", "options": "Load1" }, "properties": [ { "id": "decimals", "value": 2 } ] },
          { "matcher": { "id": "byName", "options": "Errors (15m)" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } ] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Last seen", "desc": true } ] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_last_seen_age_seconds{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_active_claims{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_slots{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_queue{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_files_rate_per_second{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_load1{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "G", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_rss_bytes{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true },
        { "refId": "H", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_errors_recent{job=\"$job\", worker=~\"$worker\"}", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true },
            "renameByName": {
              "worker": "Worker",
              "Value #A": "Last seen",
              "Value #B": "Active",
              "Value #C": "Slots",
              "Value #D": "Queue",
              "Value #E": "Files/s",
              "Value #F": "Load1",
              "Value #G": "RSS",
              "Value #H": "Errors (15m)"
            },
            "indexByName": {
              "worker": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Per-worker files/sec",
      "description": "Throughput each worker reports. A worker flatlining at zero while others run is wedged.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_files_rate_per_second{job=\"$job\", worker=~\"$worker\"}", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "Per-worker last seen age",
      "description": "Seconds since each worker last checked in. A climbing line is a node going stale (alert fires at 600s).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 0, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 600 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_last_seen_age_seconds{job=\"$job\", worker=~\"$worker\"}", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 34,
      "title": "Claim utilization (active / slots)",
      "description": "Fraction of each worker's advertised slots currently holding a task. Pinned near 1 fleet-wide means add capacity; near 0 with backlog means dispatch is starved.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_worker_active_claims{job=\"$job\", worker=~\"$worker\"} / clamp_min(hopper_worker_slots{job=\"$job\", worker=~\"$worker\"}, 1)", "legendFormat": "{{worker}}" }
      ]
    },
    {
      "type": "row",
      "id": 40,
      "title": "Local scan worker",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 41,
      "title": "Local worker up",
      "description": "Health of the in-process litmus worker over time. 0 means down.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20, "showPoints": "never", "spanNulls": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "hopper_local_worker_up{job=\"$job\"}", "legendFormat": "up" }
      ]
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "Local worker restarts",
      "description": "Supervisor restarts of the local scan worker per 15m. Repeated restarts mean it is crash-looping (flapping alert fires above 3 in 15m).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "increase(hopper_local_worker_restarts_total{job=\"$job\"}[15m])", "legendFormat": "restarts /15m" }
      ]
    },
    {
      "type": "row",
      "id": 50,
      "title": "Database pool (obs db_pool_*)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 51,
      "title": "Pool connections",
      "description": "pgx pool composition against its ceiling. acquired riding max with idle near zero is saturation — the precondition for the lock-timeout insert drops above.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [ 8, 8 ] } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "db_pool_acquired{job=\"$job\"}", "legendFormat": "acquired {{pool}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "db_pool_idle{job=\"$job\"}", "legendFormat": "idle {{pool}}" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "db_pool_constructing{job=\"$job\"}", "legendFormat": "constructing {{pool}}" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "db_pool_max{job=\"$job\"}", "legendFormat": "max {{pool}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 52,
      "title": "Pool saturation",
      "description": "Checked-out connections as a fraction of the pool ceiling. Sustained near 1.0 means queries are queuing for a connection.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.95 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "db_pool_acquired{job=\"$job\"} / clamp_min(db_pool_max{job=\"$job\"}, 1)", "legendFormat": "{{pool}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 53,
      "title": "Acquire waits & cancellations",
      "description": "Rate of acquires that had to wait for an empty pool, and acquires canceled by context (timeout) while waiting. canceled_acquire climbing means callers are giving up before getting a connection — direct contention pressure.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 57 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "canceled/s" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(db_pool_wait_count_total{job=\"$job\"}[5m]))", "legendFormat": "waits/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(db_pool_canceled_acquire_total{job=\"$job\"}[5m]))", "legendFormat": "canceled/s" }
      ]
    },
    {
      "type": "row",
      "id": 60,
      "title": "Process & runtime (obs go_* / process_*)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 61,
      "title": "Resident memory (RSS)",
      "description": "process_resident_memory_bytes — the figure the OOM killer and the cgroup MemoryMax watch. Hopper has a swap-death history; watch this against the host's limit.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 66 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "process_resident_memory_bytes{job=\"$job\"}", "legendFormat": "{{instance}} RSS" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_memstats_heap_inuse_bytes{job=\"$job\"}", "legendFormat": "{{instance}} heap inuse" }
      ]
    },
    {
      "type": "timeseries",
      "id": 62,
      "title": "CPU (cores)",
      "description": "rate(process_cpu_seconds_total) — CPU seconds consumed per second, i.e. effective cores in use.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 66 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(process_cpu_seconds_total{job=\"$job\"}[5m])", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "id": 63,
      "title": "Goroutines & threads",
      "description": "go_goroutines and go_threads. A goroutine count that climbs without bound is a leak (often blocked on the DB).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 66 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_goroutines{job=\"$job\"}", "legendFormat": "{{instance}} goroutines" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_threads{job=\"$job\"}", "legendFormat": "{{instance}} threads" }
      ]
    },
    {
      "type": "timeseries",
      "id": 64,
      "title": "Open file descriptors",
      "description": "process_open_fds against process_max_fds. Approaching the max means accept()/open() will start failing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 66 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [ 8, 8 ] } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "process_open_fds{job=\"$job\"}", "legendFormat": "{{instance}} open" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "process_max_fds{job=\"$job\"}", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "id": 65,
      "title": "Heap & GC target",
      "description": "Live heap vs the next-GC target. Heap riding its target with frequent GCs means allocation pressure.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_memstats_heap_alloc_bytes{job=\"$job\"}", "legendFormat": "{{instance}} heap alloc" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_memstats_next_gc_bytes{job=\"$job\"}", "legendFormat": "{{instance}} next GC target" }
      ]
    },
    {
      "type": "timeseries",
      "id": 66,
      "title": "GC pause & frequency",
      "description": "Stop-the-world GC pause quantiles (go_gc_duration_seconds) and collections per second. Rising pauses add tail latency.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 74 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "GCs/s" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_gc_duration_seconds{job=\"$job\", quantile=\"0.75\"}", "legendFormat": "{{instance}} p75" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "go_gc_duration_seconds{job=\"$job\", quantile=\"1\"}", "legendFormat": "{{instance}} max" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(go_gc_duration_seconds_count{job=\"$job\"}[5m])", "legendFormat": "GCs/s" }
      ]
    }
  ]
}
